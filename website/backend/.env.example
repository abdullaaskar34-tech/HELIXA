# HELIXA backend configuration — copy to .env and adjust.
# Never commit the real .env file.

# Where the scientific results live (default: ../../NEW_START_RESULTS)
HELIXA_RESULTS=../../NEW_START_RESULTS

# Comma-separated list of allowed browser origins
HELIXA_CORS=http://localhost:5173,http://127.0.0.1:5173
